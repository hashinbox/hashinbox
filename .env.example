# Optional local shell environment for `hashinbox`.
#
# Runtime topology, RPC endpoint URLs, network identity, and the index file path
# belong in the configuration document passed to the executable (TOML for a
# `.toml` path, JSON otherwise). Every secret stays
# in the process environment and is named from that file: an RPC credential
# through a `${NAME}` reference inside the endpoint's URL.
#
# Copy this file to an untracked local file, set mode 600, replace the value,
# and source only that trusted local copy. Never commit a real token.

# RPC credentials referenced from an endpoint in the configuration document:
#   endpoints = ['http://${BTC_RPC_USER}:${BTC_RPC_PASSWORD}@127.0.0.1:18443']
#   endpoints = ['https://eth.provider.example/v3/${ETH_RPC_KEY}']
#   endpoints = ['https://eth.provider.example/v1?header.x-api-key=${ETH_RPC_KEY}']
# A `header.<Name>` query parameter is sent as that header, not in the URL.
# export BTC_RPC_USER='bitcoin'
# export BTC_RPC_PASSWORD='replace-with-the-local-node-password'
# export ETH_RPC_KEY='replace-with-the-provider-api-key'

# Where the browser page at / sends its API calls. Leave unset when this server
# serves both; set it when a proxy or another origin fronts the API.
# export HASHINBOX_UI_API_BASE='https://payments.example/api'

# Keep loopback RPC traffic out of ambient proxies during local development.
export NO_PROXY='127.0.0.1,localhost'
export no_proxy="${NO_PROXY}"
